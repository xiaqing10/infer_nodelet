# Package Information for pkg-config

prefix=/home/yangshunan/work/cnopencv/opencv-3.4.6/build/install
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir_old=${prefix}/include/opencv
includedir_new=${prefix}/include

Name: OpenCV
Description: Open Source Computer Vision Library
Version: 3.4.6
Libs: -L${exec_prefix}/lib -lopencv_dnn -lopencv_videostab -lopencv_stitching -lopencv_shape -lopencv_objdetect -lopencv_calib3d -lopencv_ml -lopencv_features2d -lopencv_highgui -lopencv_flann -lopencv_photo -lopencv_superres -lopencv_videoio -lopencv_imgcodecs -lopencv_video -lopencv_imgproc -lopencv_core
Libs.private: -ldl -lm -lpthread -lrt
Cflags: -I${includedir_old} -I${includedir_new}
